#!/bin/bash
# jkkonfig: Arbeitsumgebung aus einer Hand.
# Ghostty, AeroSpace, macOS-Einstellungen, Dock, Animationen und Wartung.
# Läuft mit der Bash 3.2, die macOS mitbringt. Nur die Wartung braucht Python 3.

VERSION=2.0.0
set -u -o pipefail

# ------------------------------------------------------------------ Pfade
quelle=${BASH_SOURCE[0]}
case $quelle in */*) ;; *) quelle=./$quelle ;; esac
while [ -L "$quelle" ]; do
    ziel=$(readlink "$quelle")
    case $ziel in /*) quelle=$ziel ;; *) quelle=${quelle%/*}/$ziel ;; esac
done
WURZEL=$(cd -P "${quelle%/*}/.." && pwd) || exit 1
unset quelle ziel
NAME=${0##*/}

KONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
ZUSTAND=${XDG_STATE_HOME:-$HOME/.local/state}/jkkonfig
TABELLE=$WURZEL/configs/macos/defaults.txt
THEMEN_ORDNER=$WURZEL/configs/ghostty/themes
DATEIEN="ghostty/config aerospace/aerospace.toml aerospace/auto-tile.sh"
AGENT_ID=com.jkkonfig.dock
AGENT_PLIST=$HOME/Library/LaunchAgents/$AGENT_ID.plist
THEME_AGENT_ID=com.jkkonfig.theme
THEME_AGENT_PLIST=$HOME/Library/LaunchAgents/$THEME_AGENT_ID.plist
HAUPT_AGENT_ID=com.jkkonfig.agent
HAUPT_AGENT_PLIST=$HOME/Library/LaunchAgents/$HAUPT_AGENT_ID.plist
THEME_AUTO_CONF=$ZUSTAND/theme_auto.conf
THEME_AUTO_AKTIV=$ZUSTAND/theme_auto.aktiv
DIENSTE="Dock Finder SystemUIServer ControlCenter WindowManager"

TROCKEN=0

# ---------------------------------------------------------------- Ausgabe
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C0=$'\033[0m' CB=$'\033[1m' CD=$'\033[2m' CG=$'\033[32m' CY=$'\033[33m' CR=$'\033[31m'
else
    C0= CB= CD= CG= CY= CR=
fi
ok()       { printf '%sok%s      %s\n' "$CG" "$C0" "$*"; }
hinweis()  { printf '%s..%s      %s\n' "$CD" "$C0" "$*"; }
warnung()  { printf '%swarn%s    %s\n' "$CY" "$C0" "$*"; }
fehler()   { printf '%sfehler%s  %s\n' "$CR" "$C0" "$*" >&2; }
wuerde()   { printf '%swürde%s   %s\n' "$CD" "$C0" "$*"; }
# Erfolgsmeldung nach einer Änderung. Im Trockenlauf wurde nichts geändert.
fertig()   { [ "$TROCKEN" = 1 ] || ok "$@"; }

# Führt einen Befehl aus. Im Trockenlauf wird er nur beschrieben.
tu() {
    local text=$1
    shift
    if [ "$TROCKEN" = 1 ]; then wuerde "$text"; return 0; fi
    "$@"
}

# ------------------------------------------------------- macOS-Einstellungen
def_lesen()      { defaults read "$1" "$2" 2>/dev/null; }
def_schreiben()  { [ "$TROCKEN" = 1 ] && return 0; defaults write "$1" "$2" "-$3" "$4" >/dev/null 2>&1; }
def_loeschen()   { [ "$TROCKEN" = 1 ] && return 0; defaults delete "$1" "$2" >/dev/null 2>&1; return 0; }

wert_setzen() {  # domain schlüssel typ wert   (»-« löscht, »=« lässt unberührt)
    case $4 in
        =) return 0 ;;
        -) def_loeschen "$1" "$2" ;;
        *) def_schreiben "$1" "$2" "$3" "$4" ;;
    esac
}

# Zeilen einer Gruppe: domain, schlüssel, typ, ein, aus, modus (tabulatorgetrennt)
tabelle() {
    awk -F'|' -v g="$1" '
        /^[ \t]*(#|$)/ { next }
        {
            for (i = 1; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
            if ($1 == g) printf "%s\t%s\t%s\t%s\t%s\t%s\n", $2, $3, $4, $5, $6, $7
        }
    ' "$TABELLE"
}

# macOS hat kein timeout. Bricht einen Befehl nach der Frist ab, damit ein hängender
# defaults-Aufruf (etwa wegen einer Berechtigungsabfrage) nie alles blockiert.
ZEITLIMIT=${JKKONFIG_ZEITLIMIT:-30}
mit_zeitlimit() {  # sekunden befehl ...
    local sek=$1 pid
    shift
    "$@" &
    pid=$!
    # Der Aufpasser beendet sich selbst, sobald der Auftrag fertig ist (kein Signal, keine Waisen)
    (
        n=$((sek * 4))
        while [ "$n" -gt 0 ] && kill -0 "$pid" 2>/dev/null; do
            sleep 0.25
            n=$((n - 1))
        done
        kill -0 "$pid" 2>/dev/null && kill "$pid" 2>/dev/null
    ) >/dev/null 2>&1 &
    wait "$pid" 2>/dev/null
}

gruppe_domain() {  # domain zeilen zustand interaktiv
    local dom=$1 zeilen=$2 zustand=$3 inter=$4 d key typ wein waus modus wert
    while IFS=$'\t' read -r d key typ wein waus modus; do
        [ "$d" = "$dom" ] || continue
        case $modus in d) continue ;; i) [ "$inter" = 1 ] || continue ;; esac
        if [ "$zustand" = ein ]; then wert=$wein; else wert=$waus; fi
        wert_setzen "$d" "$key" "$typ" "$wert"
    done <<EOF
$zeilen
EOF
}

# Wendet eine Gruppe an. Je Domain läuft ein eigener Auftrag mit eigener Frist, damit
# cfprefsd parallel arbeiten kann. interaktiv=1 schließt auch sandboxed Apps ein.
gruppe_anwenden() {  # gruppe zustand(ein|aus) [interaktiv]
    local gruppe=$1 zustand=$2 inter=${3:-0}
    local zeilen dom d key typ wein waus modus doms n=0
    zeilen=$(tabelle "$gruppe")
    [ -n "$zeilen" ] || return 0
    doms=$(printf '%s\n' "$zeilen" | awk -F'\t' '!gesehen[$1]++ { print $1 }')
    for dom in $doms; do
        mit_zeitlimit "$ZEITLIMIT" gruppe_domain "$dom" "$zeilen" "$zustand" "$inter" &
    done
    wait
    while IFS=$'\t' read -r d key typ wein waus modus; do
        case $modus in d) continue ;; i) [ "$inter" = 1 ] || continue ;; esac
        n=$((n + 1))
    done <<EOF
$zeilen
EOF
    [ "$TROCKEN" = 1 ] && wuerde "$n Werte der Gruppe »${gruppe}« schreiben (Zustand ${zustand})"
    GRUPPEN_ANZAHL=$n
}

# --------------------------------------------------------------------- Dock
dock_versteckt() {
    local verzoegerung
    [ "$(def_lesen com.apple.dock autohide)" = 1 ] || return 1
    verzoegerung=$(def_lesen com.apple.dock autohide-delay)
    [ "${verzoegerung%%.*}" -ge 100 ] 2>/dev/null
}

anim_ist_aus() { [ "$(def_lesen NSGlobalDomain NSAutomaticWindowAnimationsEnabled)" = 0 ]; }

dock_neu_starten() { tu "Dock neu starten" killall Dock >/dev/null 2>&1; return 0; }

dock_werte() {  # aus (verstecken) | ein (zeigen)
    if [ "$1" = aus ]; then
        def_schreiben com.apple.dock autohide bool true
        def_schreiben com.apple.dock autohide-delay float 3600
        def_schreiben com.apple.dock autohide-time-modifier float 0
    else
        def_schreiben com.apple.dock autohide bool false
        def_loeschen com.apple.dock autohide-delay
        if anim_ist_aus; then
            def_schreiben com.apple.dock autohide-time-modifier float 0
        else
            def_loeschen com.apple.dock autohide-time-modifier
        fi
    fi
}

xml_maskieren() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

agent_aktiv() { launchctl print "gui/$UID/$AGENT_ID" >/dev/null 2>&1; }

# Wächter: startet nur, wenn sich die Dock-Einstellungen ändern (kein Dauerprozess)
agent_installieren() {
    if [ "$TROCKEN" = 1 ]; then wuerde "Wächter $AGENT_ID einrichten"; return 0; fi
    local bin plist
    bin=$(xml_maskieren "$WURZEL/bin/jkkonfig")
    plist=$(xml_maskieren "$HOME/Library/Preferences/com.apple.dock.plist")
    mkdir -p "${AGENT_PLIST%/*}" || return 1
    cat > "$AGENT_PLIST.neu" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$AGENT_ID</string>
    <key>ProgramArguments</key>
    <array>
        <string>$bin</string>
        <string>dock</string>
        <string>pruefen</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>$plist</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
EOF
    mv -f "$AGENT_PLIST.neu" "$AGENT_PLIST" || return 1
    launchctl bootout "gui/$UID/$AGENT_ID" >/dev/null 2>&1
    launchctl bootstrap "gui/$UID" "$AGENT_PLIST" >/dev/null 2>&1
}

agent_entfernen() {
    if [ "$TROCKEN" = 1 ]; then wuerde "Wächter $AGENT_ID entfernen"; return 0; fi
    launchctl bootout "gui/$UID/$AGENT_ID" >/dev/null 2>&1
    rm -f "$AGENT_PLIST"
    return 0
}

absicht_speichern() { [ "$TROCKEN" = 1 ] || { mkdir -p "$ZUSTAND" && printf '%s\n' "$1" > "$ZUSTAND/dock"; }; }
absicht_lesen()     { cat "$ZUSTAND/dock" 2>/dev/null; }

dock_setzen() {  # aus | ein
    local ziel=$1 war_versteckt=0
    dock_versteckt && war_versteckt=1
    dock_werte "$ziel"
    absicht_speichern "$ziel"
    if [ "$ziel" = aus ]; then
        agent_installieren
        [ "$war_versteckt" = 1 ] || dock_neu_starten
        fertig "Dock: versteckt"
    else
        agent_entfernen
        [ "$war_versteckt" = 0 ] || dock_neu_starten
        fertig "Dock: sichtbar"
    fi
}

cmd_dock() {
    case ${1:-status} in
        aus) dock_setzen aus ;;
        ein) dock_setzen ein ;;
        umschalten|toggle)
            if dock_versteckt; then dock_setzen ein; else dock_setzen aus; fi ;;
        pruefen)
            # Vom Wächter aufgerufen: stellt die gewünschte Einstellung wieder her
            if [ "$(absicht_lesen)" = aus ] && ! dock_versteckt; then
                dock_werte aus
                dock_neu_starten
            fi ;;
        status)
            if dock_versteckt; then ok "Dock: versteckt"; else ok "Dock: sichtbar"; fi
            if agent_aktiv; then hinweis "Wächter aktiv"; else hinweis "Wächter nicht aktiv"; fi ;;
        *) fehler "Unbekannt: dock $1 (ein, aus, umschalten, status)"; return 2 ;;
    esac
}

# ---------------------------------------------------------------- Animationen
mail_container() {  # ein | aus
    local pfad="$HOME/Library/Containers/com.apple.mail/Data/Library/Preferences/com.apple.mail" wert=true k
    [ -d "${pfad%/*}" ] || return 0
    [ "$1" = ein ] && wert=false
    for k in DisableSendAnimations DisableReplyAnimations; do
        [ "$TROCKEN" = 1 ] || defaults write "$pfad" "$k" -bool "$wert" >/dev/null 2>&1
    done
}

anim_anwenden() {  # ein|aus [interaktiv]
    local z=$1 inter=${2:-0} wert=false
    gruppe_anwenden anim "$z" "$inter"
    # Ein verstecktes Dock behält seine Werte, sonst folgt es dem Animationszustand
    if dock_versteckt; then
        def_schreiben com.apple.dock autohide-delay float 3600
        def_schreiben com.apple.dock autohide-time-modifier float 0
    elif [ "$z" = aus ]; then
        def_schreiben com.apple.dock autohide-delay float 0.0
        def_schreiben com.apple.dock autohide-time-modifier float 0.0
    else
        def_loeschen com.apple.dock autohide-delay
        def_loeschen com.apple.dock autohide-time-modifier
    fi
    [ "$inter" = 1 ] && mail_container "$z"
    [ "$z" = ein ] && wert=true
    [ "$TROCKEN" = 1 ] || defaults -currentHost write NSGlobalDomain NSAutomaticWindowAnimationsEnabled -bool "$wert" >/dev/null 2>&1
    return 0
}

cmd_anim() {
    local ziel=${1:-status} war_aus=0
    case $ziel in
        status)
            if anim_ist_aus; then ok "Animationen: aus"; else ok "Animationen: ein"; fi ;;
        ein|aus)
            anim_ist_aus && war_aus=1
            [ "$TROCKEN" = 1 ] || hinweis "Schreibe Einstellungen (Mail und Safari können eine Berechtigungsabfrage auslösen)"
            anim_anwenden "$ziel" 1
            fertig "Animationen: $ziel"
            if { [ "$ziel" = aus ] && [ "$war_aus" = 0 ]; } || { [ "$ziel" = ein ] && [ "$war_aus" = 1 ]; }; then
                # shellcheck disable=SC2086
                tu "Dienste neu starten ($DIENSTE)" killall $DIENSTE >/dev/null 2>&1
                [ "$TROCKEN" = 1 ] || hinweis "Dienste neu gestartet, geöffnete Apps übernehmen es beim nächsten Start"
            fi ;;
        *) fehler "Unbekannt: anim $ziel (ein, aus, status)"; return 2 ;;
    esac
}

# Wartungsschritt »UI & Defaults«: Komfortwerte setzen, Animationszustand angleichen
cmd_defaults() {
    gruppe_anwenden komfort ein 0
    local komfort=$GRUPPEN_ANZAHL zustand=ein
    anim_ist_aus && zustand=aus
    anim_anwenden "$zustand" 0
    fertig "$komfort Komfortwerte gesetzt, Animationen ${zustand} angeglichen"
}

# ------------------------------------------------------- Dateien und Sicherung
SICHERUNG=

# Hält die zehn neuesten Sicherungen
sicherungen_kuerzen() {
    local alt
    [ "$TROCKEN" = 1 ] && return 0
    for alt in $(ls -1d "$ZUSTAND"/sicherungen/*/ 2>/dev/null | LC_ALL=C sort |
        awk '{ z[NR] = $0 } END { for (i = 1; i <= NR - 10; i++) print z[i] }'); do
        rm -r "$alt" 2>/dev/null
    done
    return 0
}

sicherung_anlegen() {  # relativer Pfad
    [ "$TROCKEN" = 1 ] && return 0
    # SICHERUNG muss in dieser Shell gesetzt werden, nicht in einer Befehlsersetzung
    [ -n "$SICHERUNG" ] || SICHERUNG=$ZUSTAND/sicherungen/$(date +%Y%m%d_%H%M%S)
    mkdir -p "$SICHERUNG/${1%/*}" && cp -p "$KONFIG/$1" "$SICHERUNG/${1%/*}/"
}

# Der Zustand vor dem allerersten »ein« wird einmal festgehalten und nie überschrieben
original_sichern() {
    local o=$ZUSTAND/original/$1
    [ "$TROCKEN" = 1 ] && return 0
    if [ -e "$o" ] || [ -e "$o.fehlt" ]; then return 0; fi
    mkdir -p "${o%/*}" || return 1
    if [ -f "$KONFIG/$1" ]; then cp -p "$KONFIG/$1" "$o"; else : > "$o.fehlt"; fi
}

datei_atomar() {  # von nach
    mkdir -p "${2%/*}" || return 1
    cp "$1" "$2.neu.$$" && mv -f "$2.neu.$$" "$2" || { rm -f "$2.neu.$$"; return 1; }
    case $2 in *.sh) chmod +x "$2" ;; esac
}

# ---------------------------------------------------------------------- Themes
theme_aktiv() {
    local t
    t=$(cat "$ZUSTAND/theme" 2>/dev/null)
    case $t in
        gruen|grün) printf '%s' "gruen" ;;
        rot)        printf '%s' "rot" ;;
        grau|"")    printf '%s' "grau" ;;
        *)
            if [ -f "$THEMEN_ORDNER/$t" ]; then
                printf '%s' "$t"
            else
                printf '%s' "grau"
            fi
            ;;
    esac
}

theme_name_anzeige() {
    case $1 in
        gruen) printf '%s' "grün" ;;
        *)     printf '%s' "$1" ;;
    esac
}

theme_vorlage() {  # name
    local n=$1
    case $n in
        grün) n=gruen ;;
    esac
    if [ -f "$THEMEN_ORDNER/$n" ]; then
        printf '%s' "$THEMEN_ORDNER/$n"
        return 0
    elif [ "$n" = grau ] && [ -f "$WURZEL/configs/ghostty/config" ]; then
        printf '%s' "$WURZEL/configs/ghostty/config"
        return 0
    fi
    return 1
}

vorlage_pfad() {  # relativer Pfad
    case $1 in
        ghostty/config)
            local aktiv
            aktiv=$(theme_aktiv)
            if [ -f "$THEMEN_ORDNER/$aktiv" ]; then
                printf '%s' "$THEMEN_ORDNER/$aktiv"
                return 0
            fi
            ;;
    esac
    printf '%s' "$WURZEL/configs/$1"
}

datei_zustand() {  # aktuell | abweichend | fehlt
    local quelle
    if [ ! -f "$KONFIG/$1" ]; then echo fehlt
    else
        quelle=$(vorlage_pfad "$1")
        if cmp -s "$quelle" "$KONFIG/$1"; then echo aktuell
        else echo abweichend; fi
    fi
}

ghostty_pfad() {
    local p
    for p in /Applications/Ghostty.app/Contents/MacOS/ghostty "$(command -v ghostty 2>/dev/null)"; do
        [ -n "$p" ] && [ -x "$p" ] && { printf '%s' "$p"; return 0; }
    done
    return 1
}

ghostty_laeuft() {
    killall -0 ghostty 2>/dev/null || killall -0 Ghostty 2>/dev/null
}

ghostty_neu_laden() {
    ghostty_laeuft || return 0
    if [ "$TROCKEN" = 1 ]; then
        wuerde "Ghostty-Konfiguration neu laden"
        return 0
    fi
    osascript <<'EOF' >/dev/null 2>&1 || true
tell application "System Events"
    if exists process "Ghostty" then
        tell process "Ghostty"
            try
                click menu item "Reload Configuration" of menu 1 of menu bar item "Ghostty" of menu bar 1
            end try
        end tell
    else if exists process "ghostty" then
        tell process "ghostty"
            try
                click menu item "Reload Configuration" of menu 1 of menu bar item "Ghostty" of menu bar 1
            end try
        end tell
    end if
end tell
EOF
    ok "Ghostty: Konfiguration neu geladen"
}

# Prüft eine Vorlage, bevor sie installiert wird
vorlage_pruefen() {  # relativer Pfad oder absolute Datei
    local vorlage g meldung
    if [ -f "$1" ]; then
        vorlage=$1
    else
        vorlage=$(vorlage_pfad "$1")
    fi
    case $1 in
        ghostty/config|ghostty/themes/*|*/ghostty/config|*/ghostty/themes/*)
            g=$(ghostty_pfad) || { hinweis "Ghostty nicht gefunden, Prüfung übersprungen"; return 0; }
            if ! meldung=$("$g" +validate-config --config-file="$vorlage" 2>&1); then
                fehler "Ghostty lehnt die Vorlage ab:"; printf '%s\n' "$meldung" >&2; return 1
            fi ;;
        *.sh)
            if ! meldung=$(bash -n "$vorlage" 2>&1); then
                fehler "Syntaxfehler in $1:"; printf '%s\n' "$meldung" >&2; return 1
            fi ;;
    esac
    return 0
}

LAUF_NEU=" "         # Dateien, die es vor diesem Lauf nicht gab
LAUF_GEAENDERT=" "   # Dateien, die dieser Lauf überschrieben hat

datei_installieren() {  # rel   Rückgabe: 0 installiert, 2 unverändert, 1 Fehler
    local rel=$1 ziel=$KONFIG/$1 quelle existierte=0
    quelle=$(vorlage_pfad "$rel")
    [ -f "$quelle" ] || { fehler "Vorlage fehlt: $quelle"; return 1; }
    if [ -f "$ziel" ] && cmp -s "$quelle" "$ziel"; then
        hinweis "$rel ist bereits aktuell"
        return 2
    fi
    vorlage_pruefen "$rel" || return 1
    if [ "$TROCKEN" = 1 ]; then wuerde "$rel installieren"; return 0; fi
    original_sichern "$rel"
    if [ -f "$ziel" ]; then existierte=1; sicherung_anlegen "$rel"; fi
    datei_atomar "$quelle" "$ziel" || { fehler "$rel konnte nicht geschrieben werden"; return 1; }
    if [ "$existierte" = 1 ]; then LAUF_GEAENDERT="$LAUF_GEAENDERT$rel "; else LAUF_NEU="$LAUF_NEU$rel "; fi
    ok "$rel installiert"
}

# Nimmt eine in diesem Lauf installierte Datei zurück (nach einem Fehlschlag)
datei_rueckgaengig() {
    local rel=$1
    case $LAUF_NEU in
        *" $rel "*) rm -f "$KONFIG/$rel"; warnung "$rel wieder entfernt (gab es vorher nicht)"; return 0 ;;
    esac
    case $LAUF_GEAENDERT in
        *" $rel "*)
            if [ -f "$SICHERUNG/$rel" ]; then
                datei_atomar "$SICHERUNG/$rel" "$KONFIG/$rel" && warnung "$rel auf den vorherigen Stand zurückgesetzt"
            fi ;;
    esac
    return 0
}

datei_zuruecksetzen() {  # rel
    local rel=$1 o=$ZUSTAND/original/$1 ziel=$KONFIG/$1
    if [ -f "$o" ]; then
        if cmp -s "$o" "$ziel" 2>/dev/null; then hinweis "$rel entspricht schon dem Ausgangszustand"
        else tu "$rel wiederherstellen" datei_atomar "$o" "$ziel" && fertig "$rel wiederhergestellt"; fi
    elif [ -e "$o.fehlt" ]; then
        if [ -e "$ziel" ]; then tu "$rel entfernen" rm -f "$ziel" && fertig "$rel entfernt (gab es vorher nicht)"
        else hinweis "$rel gab es vorher nicht und gibt es nicht mehr"; fi
    else
        warnung "$rel: kein Ausgangszustand gesichert, bleibt unverändert"
    fi
}

# ------------------------------------------------------------------ AeroSpace
# JKKONFIG_AEROSPACE überschreibt den Pfad (leer: AeroSpace gilt als nicht vorhanden)
AS=
if [ -n "${JKKONFIG_AEROSPACE+x}" ]; then
    AS=$JKKONFIG_AEROSPACE
else
    for p in "$(command -v aerospace 2>/dev/null)" /opt/homebrew/bin/aerospace /usr/local/bin/aerospace; do
        if [ -n "$p" ] && [ -x "$p" ]; then AS=$p; break; fi
    done
    unset p
fi

as_laeuft() { [ -n "$AS" ] && "$AS" list-workspaces --focused >/dev/null 2>&1; }

as_starten() {
    as_laeuft && return 0
    if [ "$TROCKEN" = 1 ]; then wuerde "AeroSpace starten"; return 0; fi
    if [ -d /Applications/AeroSpace.app ] || [ -n "${JKKONFIG_AEROSPACE:-}" ]; then
        open -a AeroSpace >/dev/null 2>&1
        local n=20
        while [ "$n" -gt 0 ] && ! as_laeuft; do
            sleep 0.1
            n=$((n - 1))
        done
        as_laeuft && return 0
    fi
    return 1
}

as_pruefen() {  # prüft die installierte Konfiguration, ohne sie zu laden
    local meldung
    as_laeuft || return 0
    if ! meldung=$("$AS" reload-config --dry-run --no-gui 2>&1); then
        fehler "AeroSpace lehnt die Konfiguration ab:"; printf '%s\n' "$meldung" >&2; return 1
    fi
}

as_laden() {
    local meldung
    if ! as_laeuft; then
        as_starten
    fi
    if as_laeuft; then
        if [ "$TROCKEN" = 1 ]; then wuerde "AeroSpace-Konfiguration neu laden"; return 0; fi
        if meldung=$("$AS" reload-config --no-gui 2>&1); then ok "AeroSpace: Konfiguration geladen"
        else fehler "AeroSpace meldet Fehler:"; printf '%s\n' "$meldung" >&2; return 1; fi
    elif [ -d /Applications/AeroSpace.app ]; then
        tu "AeroSpace starten" open -a AeroSpace && fertig "AeroSpace gestartet"
    else
        warnung "AeroSpace ist nicht installiert (brew bundle im Projektordner)"
    fi
}

abhaengigkeiten_pruefen() {
    [ -d /Applications/Ghostty.app ] || warnung "Ghostty fehlt: brew install --cask ghostty"
    [ -d /Applications/AeroSpace.app ] || warnung "AeroSpace fehlt: brew install --cask nikitabobko/tap/aerospace"
    [ -n "$(ls -d "$HOME"/Library/Fonts/KodeMono* /Library/Fonts/KodeMono* 2>/dev/null)" ] ||
        warnung "Schrift Kode Mono fehlt: brew install --cask font-kode-mono"
    return 0
}

# --------------------------------------------------------------------- Befehle
cmd_ein() {
    local rel rc wm_alt
    abhaengigkeiten_pruefen
    for rel in $DATEIEN; do
        datei_installieren "$rel"
        [ $? -eq 1 ] && return 1
    done
    if ! as_pruefen; then
        for rel in $DATEIEN; do datei_rueckgaengig "$rel"; done
        fehler "Abgebrochen, die vorherigen Dateien sind wiederhergestellt"
        return 1
    fi

    wm_alt="$(def_lesen com.apple.WindowManager EnableTilingByEdgeDrag)$(def_lesen com.apple.WindowManager EnableTopTilingByEdgeDrag)"
    gruppe_anwenden arbeitsplatz ein 0
    gruppe_anwenden komfort ein 0
    fertig "macOS-Einstellungen gesetzt (Rand-Kacheln aus, Drei-Finger-Wischen an, Komfortwerte)"
    [ "$wm_alt" = 00 ] || tu "WindowManager neu starten" killall WindowManager >/dev/null 2>&1

    haupt_agent_installieren

    as_laden
    rc=$?
    ghostty_neu_laden
    if [ "$TROCKEN" = 1 ]; then
        printf '\nTrockenlauf beendet, es wurde nichts geändert.\n'
    else
        sicherungen_kuerzen
        printf '\n%sjkkonfig ist aktiv.%s Ghostty einmal neu starten, damit alles greift.\n' "$CB" "$C0"
    fi
    return $rc
}

cmd_aus() {
    local rel wm_alt
    for rel in $DATEIEN; do datei_zuruecksetzen "$rel"; done
    wm_alt="$(def_lesen com.apple.WindowManager EnableTilingByEdgeDrag)$(def_lesen com.apple.WindowManager EnableTopTilingByEdgeDrag)"
    gruppe_anwenden arbeitsplatz aus 0
    fertig "macOS: Rand-Kacheln wieder an"
    [ "$wm_alt" = 11 ] || tu "WindowManager neu starten" killall WindowManager >/dev/null 2>&1
    haupt_agent_entfernen
    as_laden
    if [ "$TROCKEN" = 1 ]; then
        printf '\nTrockenlauf beendet, es wurde nichts geändert.\n'
    else
        printf '\n%sjkkonfig ist deaktiviert.%s\n' "$CB" "$C0"
    fi
}

cmd_reload() {
    as_starten
    as_pruefen || return 1
    as_laden
    ghostty_neu_laden
}

cmd_backup() {
    local rel n=0
    for rel in $DATEIEN; do
        if [ -f "$KONFIG/$rel" ]; then tu "$rel sichern" sicherung_anlegen "$rel"; n=$((n + 1)); fi
    done
    if [ "$n" -gt 0 ]; then
        [ "$TROCKEN" = 1 ] || { sicherungen_kuerzen; ok "$n Dateien gesichert in $SICHERUNG"; }
    else
        hinweis "Es sind keine installierten Dateien vorhanden"
    fi
}

cmd_diff() {
    local rel quelle
    for rel in $DATEIEN; do
        printf '%s%s%s\n' "$CB" "$rel" "$C0"
        if [ -f "$KONFIG/$rel" ]; then
            quelle=$(vorlage_pfad "$rel")
            diff -u "$KONFIG/$rel" "$quelle" || true
        else
            hinweis "nicht installiert"
        fi
        echo
    done
}

# ----------------------------------------------------------- Auto-Theme (Zeit)
THEME_TAG_START="04:00"
THEME_NACHT_START="18:00"
THEME_TAG_NAME="gruen"
THEME_NACHT_NAME="rot"

theme_auto_zeiten_lesen() {
    THEME_TAG_START="04:00"
    THEME_NACHT_START="18:00"
    THEME_TAG_NAME="gruen"
    THEME_NACHT_NAME="rot"
    [ -f "$THEME_AUTO_CONF" ] || return 0
    local k v
    while IFS='=' read -r k v; do
        case $k in
            tag_start)   THEME_TAG_START=$v ;;
            nacht_start) THEME_NACHT_START=$v ;;
            tag_theme)   THEME_TAG_NAME=$v ;;
            nacht_theme) THEME_NACHT_NAME=$v ;;
        esac
    done < "$THEME_AUTO_CONF"
}

theme_auto_zeiten_speichern() {
    [ "$TROCKEN" = 1 ] && return 0
    mkdir -p "$ZUSTAND" || return 1
    cat > "$THEME_AUTO_CONF" <<EOF
tag_start=$THEME_TAG_START
nacht_start=$THEME_NACHT_START
tag_theme=$THEME_TAG_NAME
nacht_theme=$THEME_NACHT_NAME
EOF
}

theme_zeit_in_minuten() {  # HH:MM
    local h=${1%%:*} m=${1#*:}
    h=${h#0}; [ -z "$h" ] && h=0
    m=${m#0}; [ -z "$m" ] && m=0
    printf '%d' $((h * 60 + m))
}

theme_auto_soll() {  # [HH:MM]
    local jetzt=${1:-$(date +%H:%M)}
    local min_jetzt min_tag min_nacht
    theme_auto_zeiten_lesen
    min_jetzt=$(theme_zeit_in_minuten "$jetzt")
    min_tag=$(theme_zeit_in_minuten "$THEME_TAG_START")
    min_nacht=$(theme_zeit_in_minuten "$THEME_NACHT_START")

    if [ "$min_tag" -lt "$min_nacht" ]; then
        if [ "$min_jetzt" -ge "$min_tag" ] && [ "$min_jetzt" -lt "$min_nacht" ]; then
            printf '%s' "$THEME_TAG_NAME"
        else
            printf '%s' "$THEME_NACHT_NAME"
        fi
    else
        if [ "$min_jetzt" -ge "$min_nacht" ] && [ "$min_jetzt" -lt "$min_tag" ]; then
            printf '%s' "$THEME_NACHT_NAME"
        else
            printf '%s' "$THEME_TAG_NAME"
        fi
    fi
}

theme_auto_agent_aktiv() {
    launchctl print "gui/$UID/$THEME_AGENT_ID" >/dev/null 2>&1
}

theme_auto_aktiv() {
    [ -f "$THEME_AUTO_AKTIV" ] || theme_auto_agent_aktiv
}

theme_auto_agent_installieren() {
    if [ "$TROCKEN" = 1 ]; then wuerde "Wächter $THEME_AGENT_ID einrichten"; return 0; fi
    local bin
    bin=$(xml_maskieren "$WURZEL/bin/jkkonfig")
    mkdir -p "${THEME_AGENT_PLIST%/*}" || return 1
    cat > "$THEME_AGENT_PLIST.neu" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$THEME_AGENT_ID</string>
    <key>ProgramArguments</key>
    <array>
        <string>$bin</string>
        <string>theme</string>
        <string>auto</string>
        <string>anwenden</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
EOF
    mv -f "$THEME_AGENT_PLIST.neu" "$THEME_AGENT_PLIST" || return 1
    launchctl bootout "gui/$UID/$THEME_AGENT_ID" >/dev/null 2>&1
    launchctl bootstrap "gui/$UID" "$THEME_AGENT_PLIST" >/dev/null 2>&1
}

theme_auto_agent_entfernen() {
    if [ "$TROCKEN" = 1 ]; then wuerde "Wächter $THEME_AGENT_ID entfernen"; return 0; fi
    launchctl bootout "gui/$UID/$THEME_AGENT_ID" >/dev/null 2>&1
    rm -f "$THEME_AGENT_PLIST"
    return 0
}

theme_auto_anwenden() {  # [HH:MM]
    local zeit=${1:-$(date +%H:%M)} soll ist
    soll=$(theme_auto_soll "$zeit")
    ist=$(theme_aktiv)
    if [ "$soll" != "$ist" ]; then
        cmd_theme "$soll"
    fi
}

cmd_theme_auto() {
    local aktion=${1:-status}
    [ $# -gt 0 ] && shift
    case $aktion in
        status)
            theme_auto_zeiten_lesen
            local t_name n_name soll ist jetzt
            t_name=$(theme_name_anzeige "$THEME_TAG_NAME")
            n_name=$(theme_name_anzeige "$THEME_NACHT_NAME")
            jetzt=$(date +%H:%M)
            soll=$(theme_name_anzeige "$(theme_auto_soll "$jetzt")")
            ist=$(theme_name_anzeige "$(theme_aktiv)")
            if theme_auto_aktiv; then
                ok "Automatische Farbschema-Umschaltung: aktiv"
                if theme_auto_agent_aktiv; then
                    hinweis "Wächter aktiv (minütliche Prüfung)"
                else
                    warnung "Wächter nicht geladen (jkkonfig theme auto ein)"
                fi
            else
                ok "Automatische Farbschema-Umschaltung: inaktiv"
                hinweis "Aktivieren mit: jkkonfig theme auto ein"
            fi
            hinweis "Zeiten: Tag ab ${THEME_TAG_START} (${t_name}), Nacht ab ${THEME_NACHT_START} (${n_name})"
            hinweis "Uhrzeit ${jetzt}: Soll »${soll}«, aktuell »${ist}«"
            ;;
        ein|an|start|enable)
            if [ "$TROCKEN" = 1 ]; then
                wuerde "Automatische Farbschema-Umschaltung aktivieren"
                return 0
            fi
            mkdir -p "$ZUSTAND" && : > "$THEME_AUTO_AKTIV"
            theme_auto_agent_installieren || { fehler "Wächter konnte nicht eingerichtet werden"; return 1; }
            fertig "Automatische Farbschema-Umschaltung aktiviert"
            theme_auto_anwenden
            ;;
        aus|off|stop|disable)
            if [ "$TROCKEN" = 1 ]; then
                wuerde "Automatische Farbschema-Umschaltung deaktivieren"
                return 0
            fi
            rm -f "$THEME_AUTO_AKTIV"
            theme_auto_agent_entfernen
            fertig "Automatische Farbschema-Umschaltung deaktiviert"
            ;;
        zeiten)
            if [ $# -eq 0 ]; then
                theme_auto_zeiten_lesen
                local t_name n_name
                t_name=$(theme_name_anzeige "$THEME_TAG_NAME")
                n_name=$(theme_name_anzeige "$THEME_NACHT_NAME")
                ok "Umschaltzeiten: Tag ab ${THEME_TAG_START} (${t_name}), Nacht ab ${THEME_NACHT_START} (${n_name})"
                hinweis "Ändern mit: jkkonfig theme auto zeiten <Tag> <Nacht> [Tag-Theme] [Nacht-Theme]"
                return 0
            fi
            local t_start=${1:-} n_start=${2:-} t_th=${3:-gruen} n_th=${4:-rot}
            case $t_th in grün) t_th=gruen ;; esac
            case $n_th in grün) n_th=gruen ;; esac
            case $t_start in
                [0-9]:[0-5][0-9]) t_start="0$t_start" ;;
                [0-1][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;;
                *) fehler "Ungültige Uhrzeit für Tag-Start: »${t_start}« (Format HH:MM erforderlich)"; return 2 ;;
            esac
            case $n_start in
                [0-9]:[0-5][0-9]) n_start="0$n_start" ;;
                [0-1][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;;
                *) fehler "Ungültige Uhrzeit für Nacht-Start: »${n_start}« (Format HH:MM erforderlich)"; return 2 ;;
            esac
            theme_vorlage "$t_th" >/dev/null || { fehler "Unbekanntes Tag-Farbschema: »${t_th}«"; return 2; }
            theme_vorlage "$n_th" >/dev/null || { fehler "Unbekanntes Nacht-Farbschema: »${n_th}«"; return 2; }
            if [ "$TROCKEN" = 1 ]; then
                wuerde "Umschaltzeiten auf Tag ${t_start} (${t_th}) und Nacht ${n_start} (${n_th}) setzen"
                return 0
            fi
            THEME_TAG_START=$t_start
            THEME_NACHT_START=$n_start
            THEME_TAG_NAME=$t_th
            THEME_NACHT_NAME=$n_th
            theme_auto_zeiten_speichern
            local tn_anzeige nn_anzeige
            tn_anzeige=$(theme_name_anzeige "$THEME_TAG_NAME")
            nn_anzeige=$(theme_name_anzeige "$THEME_NACHT_NAME")
            fertig "Umschaltzeiten gesetzt: Tag ab ${THEME_TAG_START} (${tn_anzeige}), Nacht ab ${THEME_NACHT_START} (${nn_anzeige})"
            if theme_auto_aktiv; then
                theme_auto_anwenden
            fi
            ;;
        anwenden)
            theme_auto_anwenden "$@"
            ;;
        *)
            fehler "Unbekannte Option: theme auto ${aktion} (status, ein, aus, zeiten)"
            return 2
            ;;
    esac
}

cmd_theme() {
    local wahl=${1:-}
    case $wahl in
        auto)
            shift
            cmd_theme_auto "$@"
            return $?
            ;;
        "")
            local aktiv anzeige
            aktiv=$(theme_aktiv)
            anzeige=$(theme_name_anzeige "$aktiv")
            ok "Ghostty-Farbschema: ${anzeige}"
            hinweis "Verfügbar: grau, grün, rot (Aufruf: jkkonfig theme <Name>)"
            if theme_auto_aktiv; then
                hinweis "Automatische Umschaltung ist aktiv (jkkonfig theme auto)"
            fi
            ;;
        status)
            local aktiv anzeige
            aktiv=$(theme_aktiv)
            anzeige=$(theme_name_anzeige "$aktiv")
            ok "Ghostty-Farbschema: ${anzeige}"
            if theme_auto_aktiv; then
                hinweis "Automatische Umschaltung ist aktiv (jkkonfig theme auto)"
            fi
            ;;
        grau|gruen|grün|rot)
            local ziel=$wahl ziel_name quelle ziel_datei
            case $ziel in grün) ziel=gruen ;; esac
            ziel_name=$(theme_name_anzeige "$ziel")
            quelle=$(theme_vorlage "$ziel") || { fehler "Vorlage für Farbschema »${ziel_name}« fehlt"; return 1; }
            ziel_datei=$KONFIG/ghostty/config

            if [ "$TROCKEN" = 1 ]; then
                wuerde "Ghostty-Farbschema »${ziel_name}« aktivieren"
                return 0
            fi

            if [ -f "$ziel_datei" ] && cmp -s "$quelle" "$ziel_datei"; then
                mkdir -p "$ZUSTAND" && printf '%s\n' "$ziel" > "$ZUSTAND/theme"
                hinweis "Farbschema »${ziel_name}« ist bereits aktiv"
                return 0
            fi

            vorlage_pruefen "$quelle" || return 1
            original_sichern "ghostty/config"
            if [ -f "$ziel_datei" ]; then
                sicherung_anlegen "ghostty/config"
            fi
            datei_atomar "$quelle" "$ziel_datei" || { fehler "Ghostty-Konfiguration konnte nicht geschrieben werden"; return 1; }
            mkdir -p "$ZUSTAND" && printf '%s\n' "$ziel" > "$ZUSTAND/theme"
            sicherungen_kuerzen
            fertig "Ghostty: Farbschema »${ziel_name}« aktiviert"
            ghostty_neu_laden
            ;;
        *)
            local quelle=$THEMEN_ORDNER/$wahl ziel_datei=$KONFIG/ghostty/config
            if [ -f "$quelle" ]; then
                if [ "$TROCKEN" = 1 ]; then
                    wuerde "Ghostty-Farbschema »${wahl}« aktivieren"
                    return 0
                fi
                if [ -f "$ziel_datei" ] && cmp -s "$quelle" "$ziel_datei"; then
                    mkdir -p "$ZUSTAND" && printf '%s\n' "$wahl" > "$ZUSTAND/theme"
                    hinweis "Farbschema »${wahl}« ist bereits aktiv"
                    return 0
                fi
                vorlage_pruefen "$quelle" || return 1
                original_sichern "ghostty/config"
                if [ -f "$ziel_datei" ]; then
                    sicherung_anlegen "ghostty/config"
                fi
                datei_atomar "$quelle" "$ziel_datei" || { fehler "Ghostty-Konfiguration konnte nicht geschrieben werden"; return 1; }
                mkdir -p "$ZUSTAND" && printf '%s\n' "$wahl" > "$ZUSTAND/theme"
                sicherungen_kuerzen
                fertig "Ghostty: Farbschema »${wahl}« aktiviert"
                ghostty_neu_laden
            else
                fehler "Unbekanntes Farbschema: ${wahl} (verfügbar: grau, grün, rot)"
                return 2
            fi
            ;;
    esac
}

ghostty_wert_ersetzen() { # datei schluessel neuer_wert
    local datei=$1 schluessel=$2 wert=$3 tmp
    [ -f "$datei" ] || return 0
    tmp="${datei}.tmp.$$"
    awk -v k="$schluessel" -v v="$wert" '
        BEGIN { gesetzt = 0 }
        $0 ~ ("^[ \t]*" k "[ \t]*=") {
            print k " = " v
            gesetzt = 1
            next
        }
        { print }
        END {
            if (!gesetzt) print k " = " v
        }
    ' "$datei" > "$tmp" && mv -f "$tmp" "$datei"
}

cmd_schriftart() {
    local datei=$KONFIG/ghostty/config
    [ -f "$datei" ] || datei=$WURZEL/configs/ghostty/config
    if [ $# -eq 0 ]; then
        local font
        font=$(sed -n -E 's/^[ \t]*font-family[ \t]*=[ \t]*"?([^"]*)"?[ \t]*$/\1/p' "$datei" 2>/dev/null | head -n 1)
        ok "Ghostty-Schriftart: ${font:-unbekannt}"
        hinweis "Aufruf: jkkonfig schriftart <Name>"
        return 0
    fi
    local neue_art="$*"
    neue_art=${neue_art#\"}
    neue_art=${neue_art%\"}
    neue_art=${neue_art#\'}
    neue_art=${neue_art%\'}
    [ -n "$neue_art" ] || { fehler "Keine Schriftart angegeben"; return 2; }
    if [ "$TROCKEN" = 1 ]; then
        wuerde "Ghostty: Schriftart auf »${neue_art}« setzen"
        return 0
    fi
    local t
    ghostty_wert_ersetzen "$WURZEL/configs/ghostty/config" "font-family" "\"${neue_art}\""
    for t in "$THEMEN_ORDNER"/*; do
        [ -f "$t" ] || continue
        ghostty_wert_ersetzen "$t" "font-family" "\"${neue_art}\""
    done
    if [ -f "$KONFIG/ghostty/config" ]; then
        original_sichern "ghostty/config"
        sicherung_anlegen "ghostty/config"
        ghostty_wert_ersetzen "$KONFIG/ghostty/config" "font-family" "\"${neue_art}\""
        sicherungen_kuerzen
    fi
    fertig "Ghostty: Schriftart auf »${neue_art}« gesetzt"
    ghostty_neu_laden
}

cmd_schriftgroesse() {
    local datei=$KONFIG/ghostty/config
    [ -f "$datei" ] || datei=$WURZEL/configs/ghostty/config
    if [ $# -eq 0 ]; then
        local groesse
        groesse=$(sed -n -E 's/^[ \t]*font-size[ \t]*=[ \t]*([0-9.]+)[ \t]*$/\1/p' "$datei" 2>/dev/null | head -n 1)
        ok "Ghostty-Schriftgröße: ${groesse:-unbekannt}"
        hinweis "Aufruf: jkkonfig schriftgröße <Punkte>"
        return 0
    fi
    local neue_groesse=$1
    case $neue_groesse in
        ''|*[!0-9.]*|.*|*.)
            fehler "Ungültige Schriftgröße: »${neue_groesse}« (positive Zahl erforderlich)"
            return 2
            ;;
    esac
    if [ "$TROCKEN" = 1 ]; then
        wuerde "Ghostty: Schriftgröße auf ${neue_groesse} setzen"
        return 0
    fi
    local t
    ghostty_wert_ersetzen "$WURZEL/configs/ghostty/config" "font-size" "$neue_groesse"
    for t in "$THEMEN_ORDNER"/*; do
        [ -f "$t" ] || continue
        ghostty_wert_ersetzen "$t" "font-size" "$neue_groesse"
    done
    if [ -f "$KONFIG/ghostty/config" ]; then
        original_sichern "ghostty/config"
        sicherung_anlegen "ghostty/config"
        ghostty_wert_ersetzen "$KONFIG/ghostty/config" "font-size" "$neue_groesse"
        sicherungen_kuerzen
    fi
    fertig "Ghostty: Schriftgröße auf ${neue_groesse} gesetzt"
    ghostty_neu_laden
}

# -------------------------------------------------------- Autostart & Wächter
haupt_agent_aktiv() {
    launchctl print "gui/$UID/$HAUPT_AGENT_ID" >/dev/null 2>&1
}

haupt_agent_installieren() {
    if [ "$TROCKEN" = 1 ]; then wuerde "Autostart-Wächter $HAUPT_AGENT_ID einrichten"; return 0; fi
    local bin
    bin=$(xml_maskieren "$WURZEL/bin/jkkonfig")
    mkdir -p "${HAUPT_AGENT_PLIST%/*}" || return 1
    cat > "$HAUPT_AGENT_PLIST.neu" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$HAUPT_AGENT_ID</string>
    <key>ProgramArguments</key>
    <array>
        <string>$bin</string>
        <string>wachen</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
EOF
    mv -f "$HAUPT_AGENT_PLIST.neu" "$HAUPT_AGENT_PLIST" || return 1
    launchctl bootout "gui/$UID/$HAUPT_AGENT_ID" >/dev/null 2>&1
    launchctl bootstrap "gui/$UID" "$HAUPT_AGENT_PLIST" >/dev/null 2>&1
}

haupt_agent_entfernen() {
    if [ "$TROCKEN" = 1 ]; then wuerde "Autostart-Wächter $HAUPT_AGENT_ID entfernen"; return 0; fi
    launchctl bootout "gui/$UID/$HAUPT_AGENT_ID" >/dev/null 2>&1
    rm -f "$HAUPT_AGENT_PLIST"
    return 0
}

cmd_wachen() {
    as_laeuft || as_starten
    if theme_auto_aktiv; then
        theme_auto_anwenden
    fi
    if [ "$(absicht_lesen)" = aus ]; then
        cmd_dock pruefen
    fi
}

cmd_autostart() {
    local aktion=${1:-status}
    case $aktion in
        status)
            if haupt_agent_aktiv; then
                ok "Autostart-Wächter: aktiv"
                hinweis "Startet bei Anmeldung und stellt sicher, dass AeroSpace stets aktiv ist"
            else
                ok "Autostart-Wächter: inaktiv"
                hinweis "Aktivieren mit: jkkonfig autostart ein"
            fi
            ;;
        ein|an|start|enable)
            if [ "$TROCKEN" = 1 ]; then
                wuerde "Autostart-Wächter aktivieren"
                return 0
            fi
            haupt_agent_installieren || { fehler "Autostart-Wächter konnte nicht eingerichtet werden"; return 1; }
            fertig "Autostart-Wächter aktiviert (startet bei Anmeldung und hält AeroSpace aktiv)"
            as_laeuft || as_starten
            ;;
        aus|off|stop|disable)
            if [ "$TROCKEN" = 1 ]; then
                wuerde "Autostart-Wächter deaktivieren"
                return 0
            fi
            haupt_agent_entfernen
            fertig "Autostart-Wächter deaktiviert"
            ;;
        *)
            fehler "Unbekannte Option: autostart ${aktion} (status, ein, aus)"
            return 2
            ;;
    esac
}

zeile() {  # bezeichnung farbe marke text
    printf '  %-16s %s%-13s%s %s\n' "$1" "$2" "[$3]" "$C0" "$4"
}

# Schlechtester Zustand aus einer Liste von Dateien
sammelzustand() {
    local rel z worst=aktuell
    for rel in "$@"; do
        z=$(datei_zustand "$rel")
        case $z in fehlt) worst=fehlt; break ;; abweichend) worst=abweichend ;; esac
    done
    printf '%s' "$worst"
}

vor() {  # Zeitstempel -> »vor 3 Tagen«
    local s=$(( $(date +%s) - $1 ))
    if [ "$s" -lt 120 ]; then echo "gerade eben"
    elif [ "$s" -lt 7200 ]; then echo "vor $((s / 60)) Min."
    elif [ "$s" -lt 172800 ]; then echo "vor $((s / 3600)) Std."
    else echo "vor $((s / 86400)) Tagen"; fi
}

cmd_status() {
    local z t absicht thema as_neu_gestartet=0
    printf '%sjkkonfig %s%s\n\n' "$CB" "$VERSION" "$C0"

    z=$(datei_zustand ghostty/config)
    thema=$(theme_name_anzeige "$(theme_aktiv)")
    case $z in
        aktuell)    zeile Ghostty "$CG" AKTIV "Konfiguration installiert und aktuell (${thema})" ;;
        abweichend) zeile Ghostty "$CY" ABWEICHEND "Datei weicht von der Vorlage ab (jkkonfig diff)" ;;
        fehlt)      zeile Ghostty "$CR" FEHLT "Keine Konfiguration (jkkonfig ein)" ;;
    esac

    if theme_auto_aktiv; then
        theme_auto_zeiten_lesen
        local t_anzeige n_anzeige
        t_anzeige=$(theme_name_anzeige "$THEME_TAG_NAME")
        n_anzeige=$(theme_name_anzeige "$THEME_NACHT_NAME")
        if theme_auto_agent_aktiv || haupt_agent_aktiv; then
            zeile Auto-Theme "$CG" AKTIV "Tag ab ${THEME_TAG_START} (${t_anzeige}), Nacht ab ${THEME_NACHT_START} (${n_anzeige})"
        else
            zeile Auto-Theme "$CY" AKTIV "ohne Wächter (jkkonfig theme auto ein richtet ihn ein)"
        fi
    else
        zeile Auto-Theme "$CD" AUS "jkkonfig theme auto ein aktiviert zeitbasierte Umschaltung"
    fi

    if ! as_laeuft; then
        if as_starten; then as_neu_gestartet=1; fi
    fi
    z=$(sammelzustand aerospace/aerospace.toml aerospace/auto-tile.sh)
    if as_laeuft; then
        case $z in
            aktuell)
                if [ "$as_neu_gestartet" = 1 ]; then
                    zeile AeroSpace "$CG" AKTIV "automatisch gestartet, Konfiguration aktuell (Cmd+T öffnet Ghostty)"
                else
                    zeile AeroSpace "$CG" AKTIV "läuft, Konfiguration aktuell (Cmd+T öffnet Ghostty)"
                fi ;;
            abweichend)
                if [ "$as_neu_gestartet" = 1 ]; then
                    zeile AeroSpace "$CY" ABWEICHEND "automatisch gestartet, Konfiguration weicht von der Vorlage ab"
                else
                    zeile AeroSpace "$CY" ABWEICHEND "läuft, Konfiguration weicht von der Vorlage ab"
                fi ;;
            fehlt)
                if [ "$as_neu_gestartet" = 1 ]; then
                    zeile AeroSpace "$CR" FEHLT "automatisch gestartet, ohne jkkonfig-Konfiguration (jkkonfig ein)"
                else
                    zeile AeroSpace "$CR" FEHLT "läuft ohne jkkonfig-Konfiguration (jkkonfig ein)"
                fi ;;
        esac
    else
        zeile AeroSpace "$CR" GESTOPPT "läuft nicht"
    fi

    if haupt_agent_aktiv; then
        zeile Autostart "$CG" AKTIV "startet bei Anmeldung und hält AeroSpace aktiv"
    else
        zeile Autostart "$CD" AUS "jkkonfig autostart ein richtet den Hintergrunddienst ein"
    fi

    absicht=$(absicht_lesen)
    if dock_versteckt; then
        if agent_aktiv || haupt_agent_aktiv; then zeile Dock "$CG" VERSTECKT "Wächter aktiv"
        else zeile Dock "$CY" VERSTECKT "ohne Wächter (jkkonfig dock aus richtet ihn ein)"; fi
    elif [ "$absicht" = aus ]; then
        zeile Dock "$CY" ABGEWICHEN "sollte versteckt sein (jkkonfig dock aus)"
    else
        zeile Dock "$CD" SICHTBAR "jkkonfig dock aus versteckt es"
    fi

    if anim_ist_aus; then zeile Animationen "$CG" AUS "Fenster und Dock ohne Übergänge"
    else zeile Animationen "$CD" EIN "jkkonfig anim aus schaltet sie ab"; fi

    if [ "$(def_lesen com.apple.WindowManager EnableTilingByEdgeDrag)" = 0 ]; then
        zeile Rand-Kacheln "$CG" AUS "kollidiert nicht mit AeroSpace"
    else
        zeile Rand-Kacheln "$CY" AN "natives Kacheln aktiv (jkkonfig ein)"
    fi
    if [ "$(def_lesen com.apple.AppleMultitouchTrackpad TrackpadThreeFingerHorizSwipeGesture)" = 2 ]; then
        zeile Drei-Finger "$CG" AN "Wischen wechselt den Schreibtisch"
    else
        zeile Drei-Finger "$CD" AUS "Wischgeste nicht gesetzt"
    fi

    if [ -f "$ZUSTAND/pflege.log" ]; then
        t=$(stat -f %m "$ZUSTAND/pflege.log" 2>/dev/null || echo 0)
        zeile Wartung "$CG" AKTUELL "letzter Lauf $(vor "$t")"
    else
        zeile Wartung "$CD" NIE "jkkonfig pflege führt sie aus"
    fi
    echo
}

python_finden() {
    local p
    for p in "$(command -v python3 2>/dev/null)" /opt/homebrew/bin/python3 /usr/local/bin/python3 \
        /Library/Developer/CommandLineTools/usr/bin/python3 /usr/bin/python3; do
        [ -n "$p" ] && [ -x "$p" ] || continue
        # Apples Platzhalter unter /usr/bin öffnet ohne Entwicklerwerkzeuge einen Installationsdialog
        if [ "$p" = /usr/bin/python3 ] && ! xcode-select -p >/dev/null 2>&1; then continue; fi
        printf '%s' "$p"
        return 0
    done
    return 1
}

cmd_pflege() {
    local py
    py=$(python_finden) || { fehler "Die Wartung braucht Python 3 (brew install python)"; return 1; }
    [ "$TROCKEN" = 1 ] && set -- "$@" --trocken
    JKKONFIG_BIN=$WURZEL/bin/jkkonfig JKKONFIG_ZUSTAND=$ZUSTAND exec "$py" "$WURZEL/lib/pflege.py" "$@"
}

cmd_hilfe() {
    cat <<EOF
${CB}jkkonfig $VERSION${C0}: Ghostty, AeroSpace, macOS-Einstellungen, Dock, Animationen, Wartung

${CB}Aufruf${C0}
  jkkonfig [Befehl] [--trocken]

${CB}Einrichtung${C0}
  status              Zustand aller Bausteine (ohne Befehl: dasselbe)
  ein                 Konfigurationen und Einstellungen aktivieren
  aus                 Zustand vor dem ersten »ein« wiederherstellen
  reload              AeroSpace-Konfiguration prüfen und neu laden
  autostart [ein|aus] Autostart-Wächter (startet bei Anmeldung, hält AeroSpace aktiv)
  diff                Installierte Dateien gegen die Vorlagen vergleichen
  backup              Installierte Dateien sichern

${CB}Ghostty-Darstellung${C0}
  theme [Name]        Farbschema einstellen oder anzeigen (grau, grün, rot)
  theme auto          Automatische Theme-Änderung nach Tageszeit (status)
  theme auto ein|aus  Automatische Theme-Änderung an- oder abschalten
  theme auto zeiten   Umschaltzeiten einstellen (z. B. 04:00 18:00 grün rot)
  schriftart [Name]   Schriftart einstellen oder anzeigen (z. B. "Kode Mono")
  schriftgröße [Zahl] Schriftgröße einstellen oder anzeigen (z. B. 18)

${CB}System${C0}
  dock aus|ein        Dock verstecken oder zeigen (umschalten, status)
  anim aus|ein        Systemanimationen ab- oder anschalten (status)
  pflege [Bausteine]  Wartung: Speicher, Datenbanken, Caches, Git, Netz, Sicherheit
                      (jkkonfig pflege --hilfe zeigt alle Optionen)

${CB}Schalter${C0}
  --trocken, -n       Nur anzeigen, was geschehen würde

${CB}Pfade${C0}
  Programm            $WURZEL
  Konfigurationen     $KONFIG
  Farbschemata        $THEMEN_ORDNER
  Ausgangszustand     $ZUSTAND/original
  Sicherungen         $ZUSTAND/sicherungen
EOF
}

# --------------------------------------------------- alte Namen: optimi, dockhide
kompat_optimi() {
    local anim= dock=
    if [ $# -eq 0 ]; then cmd_pflege; return; fi
    while [ $# -gt 0 ]; do
        case $1 in
            --anim) anim=${2:-}; shift; [ $# -gt 0 ] && shift ;;
            -d)     dock=${2:-};  shift; [ $# -gt 0 ] && shift ;;
            *)      cmd_pflege "$@"; return ;;
        esac
    done
    local rc=0
    [ -n "$dock" ] && { cmd_dock "$dock" || rc=$?; }
    [ -n "$anim" ] && { cmd_anim "$anim" || rc=$?; }
    return $rc
}

kompat_dockhide() {  # dockhide meinte mit »ein« das Verstecken
    case ${1:-status} in
        ein|on|start|enable)   cmd_dock aus ;;
        aus|off|stop|disable)  cmd_dock ein ;;
        toggle|switch)         cmd_dock umschalten ;;
        status|st|info)        cmd_dock status ;;
        daemon)                return 0 ;;
        *)                     cmd_dock "$1" ;;
    esac
}

# ---------------------------------------------------------------------- Start
main() {
    local rest=() a
    for a in "$@"; do
        case $a in
            --trocken|-n) TROCKEN=1 ;;
            *) rest[${#rest[@]}]=$a ;;
        esac
    done
    set -- ${rest[@]+"${rest[@]}"}

    case $NAME in
        optimi)   kompat_optimi "$@"; return ;;
        dockhide) kompat_dockhide "$@"; return ;;
    esac

    local befehl=${1:-status}
    [ $# -gt 0 ] && shift
    case $befehl in
        status)                  cmd_status ;;
        ein|an|install)          cmd_ein ;;
        aus|revert|uninstall)    cmd_aus ;;
        reload)                  cmd_reload ;;
        autostart|agent|waechter|wächter) cmd_autostart "$@" ;;
        wachen)                  cmd_wachen ;;
        diff)                    cmd_diff ;;
        backup)                  cmd_backup ;;
        theme|thema)             cmd_theme "$@" ;;
        auto-theme|autotheme)    cmd_theme_auto "$@" ;;
        schriftart|font)         cmd_schriftart "$@" ;;
        schriftgröße|schriftgroesse|fontsize|size) cmd_schriftgroesse "$@" ;;
        dock)                    cmd_dock "$@" ;;
        anim)                    cmd_anim "$@" ;;
        defaults)                cmd_defaults ;;
        pflege)                  cmd_pflege "$@" ;;
        hilfe|help|-h|--help)    cmd_hilfe ;;
        --version|version)       echo "jkkonfig $VERSION" ;;
        *) fehler "Unbekannter Befehl: $befehl (jkkonfig hilfe)"; return 2 ;;
    esac
}

main "$@"
