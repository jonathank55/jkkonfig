# Ghostty: Hacker-Rot, angenehm und blendfrei
# Zusammen mit AeroSpace gedacht: keine Overlays, keine Hinweise, kein Rauschen.

# Typografie
font-family = "Kode Mono"
font-size = 16

# Farben: samtiges Hacker-Dunkelrot und angenehmes Signalrot
background = #0d0303
foreground = #ff5c4d
selection-background = #ff5c4d
selection-foreground = #1a0504

# Cursor: fester, nicht blinkender Block
cursor-style = block
cursor-style-blink = false
cursor-color = #ff5c4d
cursor-text = #0d0303
cursor-opacity = 1
mouse-hide-while-typing = true

# Arbeitsverzeichnis: neue Fenster, Tabs und Splits erben es vom aktiven Fenster
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Shell-Integration meldet das Verzeichnis (OSC 7), der Cursor-Stil bleibt unberührt
shell-integration = detect
shell-integration-features = no-cursor,path

# Fenster: native Ränder zum Greifen mit der Maus, stufenlose Größenänderung
window-decoration = auto
window-step-resize = false
split-divider-color = #3a1512
macos-titlebar-style = transparent
macos-window-buttons = visible
macos-titlebar-proxy-icon = hidden
macos-window-shadow = true
title = " "
window-subtitle = false
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

# Tastenkürzel
# Cmd+M schließt das Fenster (statt es zu minimieren)
keybind = super+m=close_window
# Cmd+D teilt nebeneinander, Cmd+Shift+D übereinander
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down

# Ruhe: keine Overlays, Töne, Banner oder Rückfragen
resize-overlay = never
scrollbar = never
confirm-close-surface = false
notify-on-command-finish-action = no-bell,no-notify
bell-features = no-system,no-audio,no-attention,no-title,no-border
auto-update = off
macos-secure-input-indication = false
macos-auto-secure-input = false

# ANSI-Palette: Hacker-Rottöne
palette = 0=#2a0d0a
palette = 1=#ffd27a
palette = 2=#d93a2e
palette = 3=#ff9a4d
palette = 4=#e0506f
palette = 5=#ff6f8f
palette = 6=#ffb3a6
palette = 7=#ffd9d2
palette = 8=#a8443a
palette = 9=#ffe6b0
palette = 10=#f2604e
palette = 11=#ffbb80
palette = 12=#f27a92
palette = 13=#ff9cb2
palette = 14=#ffd0c7
palette = 15=#fff0ec
