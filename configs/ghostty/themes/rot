# Ghostty: Profil »rot« (identisch zum macOS-Terminal-Profil »rot«)
# Zusammen mit AeroSpace gedacht: keine Overlays, keine Hinweise, kein Rauschen.

# Typografie
font-family = "Kode Mono"
font-size = 18

# Farben: exakte Werte des macOS-Terminal-Profils »rot«
background = #1e0000
foreground = #ff2600
selection-background = #ff2600
selection-foreground = #1e0000

# Cursor: fester, nicht blinkender Block
cursor-style = block
cursor-style-blink = false
cursor-color = #ff2600
cursor-text = #1e0000
cursor-opacity = 1
mouse-hide-while-typing = true

# Arbeitsverzeichnis: neue Fenster, Tabs und Splits erben es vom aktiven Fenster
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Shell-Integration meldet das Verzeichnis (OSC 7), der Cursor-Stil bleibt unberührt
shell-integration = detect
shell-integration-features = no-cursor,path

# Fenster: native Ränder zum Greifen mit der Maus, stufenlose Größenänderung
window-decoration = auto
window-step-resize = false
split-divider-color = #3a0000
drag-handle = never
macos-titlebar-style = transparent
macos-window-buttons = visible
macos-titlebar-proxy-icon = hidden
macos-window-shadow = true
title = " "
window-subtitle = false
window-padding-x = 20
window-padding-y = 20
window-padding-balance = true

# Tastenkürzel
# Cmd+M schließt das Fenster (statt es zu minimieren)
keybind = super+m=close_window
# Cmd+D teilt nebeneinander, Cmd+Shift+D übereinander
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down

# Ruhe: keine Overlays, Töne, Banner oder Rückfragen
resize-overlay = never
scrollbar = never
confirm-close-surface = false
notify-on-command-finish-action = no-bell,no-notify
bell-features = no-system,no-audio,no-attention,no-title,no-border
auto-update = off
macos-secure-input-indication = false
macos-auto-secure-input = false

# ANSI-Palette: Hacker-Rottöne von Dunkelrot bis Signalrot
palette = 0=#1e0000
palette = 1=#d62000
palette = 2=#ff2600
palette = 3=#ff401a
palette = 4=#b81c00
palette = 5=#e62300
palette = 6=#ff330d
palette = 7=#ffd6cc
palette = 8=#660d00
palette = 9=#ff2600
palette = 10=#ff3d1a
palette = 11=#ff5433
palette = 12=#cc2000
palette = 13=#f02600
palette = 14=#ff664d
palette = 15=#fff0ec
