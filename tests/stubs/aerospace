#!/bin/bash
# Attrappe für aerospace. Fensterliste aus $STUB_ZUSTAND/fenster.txt, Fokus-Workspace
# aus $STUB_ZUSTAND/fokus (Vorgabe 1). Die Datei as-fehler lässt reload-config scheitern.
Z=${STUB_ZUSTAND:?}
case ${1:-} in
    list-workspaces) cat "$Z/fokus" 2>/dev/null || echo 1 ;;
    list-windows)    cat "$Z/fenster.txt" 2>/dev/null ;;
    reload-config)
        printf 'aerospace %s\n' "$*" >> "$Z/aufrufe.log"
        if [ -e "$Z/as-fehler" ]; then echo "ERROR: Testfehler in der Konfiguration"; exit 1; fi
        ;;
    eval) printf '%s\n' "$2" >> "$Z/eval.log" ;;
esac
exit 0
