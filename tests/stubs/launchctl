#!/bin/bash
# Attrappe für launchctl: merkt sich nur, ob der Wächter geladen ist.
Z=${STUB_ZUSTAND:?}
printf 'launchctl %s\n' "$*" >> "$Z/aufrufe.log"
case ${1:-} in
    print)
        id=${2##*/}
        if [ -n "$id" ] && [ -e "$Z/agent-$id" ]; then exit 0; fi
        [ -e "$Z/agent-geladen" ]; exit $?
        ;;
    bootstrap)
        plist=${3:-$2}
        id=$(basename "$plist" .plist)
        : > "$Z/agent-$id"
        : > "$Z/agent-geladen"
        ;;
    bootout)
        id=${2##*/}
        rm -f "$Z/agent-$id" "$Z/agent-geladen"
        ;;
esac
exit 0
